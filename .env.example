# Autonomous B2B Lead Generation, Cold Outreach & Meeting Booking Engine
# Environment Configuration Template

# Gemini 2.0 Flash AI Engine (Free Tier: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Security & Session Management
FLASK_SECRET_KEY=generate_random_32_byte_secret
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=admin_password_123

# SMTP Outbound Dispatcher (Authenticated Port 587 STARTTLS or Port 465 SSL)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_NAME="Harsha | Outbound Suite"

# Telegram Real-Time Booking Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_ID=your_telegram_chat_id

# Engine Mode: "self" (dogfooding / agency growth) or "client" (customer outbound)
ENGINE_MODE=self

# Booking Gateway URL (Cal.com, Calendly, or built-in /book/<slug>)
PUBLIC_BOOKING_URL=https://cal.com/your-username/15min

# Webhook Authentication Secret for Cal.com / Calendly HMAC Validation
BOOKING_WEBHOOK_SECRET=your_webhook_secret_key

# Operational Safeguards
DAILY_EMAIL_CAP=30
MIN_SEND_DELAY_SECONDS=120
MAX_SEND_DELAY_SECONDS=240
