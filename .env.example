# ═══════════════════════════════════════════════════════════════════════════
# Autonomous Affiliate Marketing & ML Optimization Suite — Environment
# Copy this file to `.env` and fill in real credentials. NEVER commit `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ── Generative AI (Gemini 2.0 Flash — free tier: https://aistudio.google.com)
GEMINI_API_KEY=

# ── Application security
FLASK_SECRET_KEY=change_me_to_a_long_random_string
POSTBACK_SECRET=change_me_shared_hmac_secret_with_your_network
ADMIN_DEFAULT_PASSWORD=admin123
# Enable ONLY when serving over HTTPS (secure cookies break plain-HTTP logins)
SESSION_COOKIE_SECURE=False

# ── Amazon Associates + PA-API v5
AMAZON_ASSOCIATE_TAG=your_tag_here
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
# Defaults: region eu-west-1, host webservices.amazon.in, marketplace amazon.in
AMAZON_PAAPI_REGION=eu-west-1
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_MARKETPLACE=amazon.in

# ── Telegram (distribution channel + operator alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_ID=

# ── Twitter / X API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Optional zero-cost alternative: Playwright browser automation for X/Twitter.
# Log in once into the persistent profile at data/playwright/ first.
PLAYWRIGHT_X_ENABLED=False
PLAYWRIGHT_HEADLESS=True

# ── Instagram Graph API
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=

# ── Open-redirect whitelist (comma separated)
TRUSTED_DOMAINS=amazon.in,amazon.com,amzn.in,amzn.to,geni.us

# ── Operational tuning
AB_EPSILON=0.20
AB_MIN_SAMPLES=20
FAST_VIDEO_RENDER=False
SCHEDULER_TZ=Asia/Kolkata
PORT=5000
# Skips all network I/O in sourcing (CI / offline demos)
MOCK_SOURCING=False
# Run the Flask dev server with debug/reloader (dev only!)
FLASK_DEBUG=False

# ── Resilience: daily API hard caps + breaker cooldowns (seconds)
QUOTA_GEMINI_CAP=150
QUOTA_TELEGRAM_CAP=300
QUOTA_PAAPI_CAP=7200
QUOTA_TWITTER_CAP=50
QUOTA_INSTAGRAM_CAP=50
QUOTA_META_CAP=50
CB_GEMINI_COOLDOWN=300
CB_TELEGRAM_COOLDOWN=300
CB_PAAPI_COOLDOWN=300
CB_TWITTER_COOLDOWN=300
CB_INSTAGRAM_COOLDOWN=300
CB_META_COOLDOWN=300

# ── Business rules (channel quality + revenue pacing)
# Deals scoring below this are never saved/posted (curation = the product)
MIN_DEAL_SCORE=35
# Max campaigns distributed per UTC day across all channels
DAILY_POST_CAP=8
# Skip products already alerted within N days…
DEDUPE_DAYS=7
# …unless price dropped this % below prior minimum ("FURTHER DROP" re-alert)
REALERT_DROP_PCT=2.0

# ── Ambient UI background theme (kelp | pavilion | train | silhouette)
BACKGROUND_THEME=train

# Public base URL used to build media URLs for the Instagram Graph API.
PUBLIC_BASE_URL=https://affiliate.example.com
