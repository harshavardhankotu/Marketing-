# Autonomous B2B Lead Generation & Call-Booking Engine - Environment Configuration

# AI Generation Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Web & Security Settings
FLASK_SECRET_KEY=change_this_to_a_secure_random_key_in_production
ADMIN_EMAIL=admin@agency.ai
ADMIN_PASSWORD=change_this_admin_password_123

# SMTP Cold Email Dispatcher
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=outreach@agency.ai
SMTP_PASS=your_smtp_app_password_here
FROM_NAME="Harsha from GrowthOps"

# Telegram Real-time Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_chat_id_here

# Engine Operation Mode ("self" = Agency internal leads, "client" = Client campaign mode)
ENGINE_MODE=self

# Call Booking Gateway
PUBLIC_BOOKING_URL=https://cal.com/growthops/strategy-session
