# Gemini API Key (Free tier: https://aistudio.google.com/app/apikey)
# Required for AI-generated social media captions.
# Without this, the pipeline uses high-quality mock captions instead.
GEMINI_API_KEY=your_gemini_api_key_here
# Telegram Delivery Configuration
# Used by distributor.py for live Telegram channel/chat delivery.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Default Admin User Password on Startup Seeding
ADMIN_DEFAULT_PASSWORD=your_secure_password_here

# Twitter / X API Credentials
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# Instagram Graph API Credentials
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
META_ACCESS_TOKEN=your_meta_access_token_here

# Meta WhatsApp Business API Credentials
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

