# ═══════════════════════════════════════════════════════════════════════════
# Autonomous Affiliate Marketing & ML Optimization Suite — Environment
# Copy this file to `.env` and fill in real credentials. NEVER commit `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ── Generative AI (Gemini 2.0 Flash — free tier: https://aistudio.google.com)
GEMINI_API_KEY=

# ── Application security
FLASK_SECRET_KEY=change_me_to_a_long_random_string
POSTBACK_SECRET=change_me_shared_hmac_secret_with_your_network
ADMIN_DEFAULT_PASSWORD=admin123

# ── Amazon Associates + PA-API v5
AMAZON_ASSOCIATE_TAG=your_tag_here
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
# Defaults: region eu-west-1, host webservices.amazon.in, marketplace amazon.in
AMAZON_PAAPI_REGION=eu-west-1
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_MARKETPLACE=amazon.in

# ── Telegram (distribution channel + operator alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_ID=

# ── Twitter / X API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Instagram Graph API
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=

# ── Open-redirect whitelist (comma separated)
TRUSTED_DOMAINS=amazon.in,amazon.com,amzn.in,amzn.to,geni.us

# ── Operational tuning
AB_EPSILON=0.20
AB_MIN_SAMPLES=20
FAST_VIDEO_RENDER=False
SCHEDULER_TZ=Asia/Kolkata
PORT=5000

# Public base URL used to build media URLs for the Instagram Graph API.
PUBLIC_BASE_URL=https://affiliate.example.com
