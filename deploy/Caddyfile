# Caddyfile - Automated HTTPS & Reverse Proxy for Autonomous B2B Outbound Engine
# Replace outreach.yourdomain.com with your live domain or server public IP

outreach.yourdomain.com {
    # Automated Let's Encrypt SSL / TLS certificate provisioning
    encode gzip zstd

    # Pass all traffic to Gunicorn bound to localhost:5000
    reverse_proxy 127.0.0.1:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Standard security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
    }

    # Static asset caching
    @static {
        path /static/*
    }
    header @static Cache-Control "public, max-age=86400"

    # Access logging
    log {
        output file /var/log/caddy/outbound_access.log {
            roll_size 10MB
            roll_keep 5
        }
    }
}
