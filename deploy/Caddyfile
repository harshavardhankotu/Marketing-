# Autonomous Affiliate Marketing Suite — Caddy reverse proxy
# Replace 'yourdomain.com' with your actual VPS domain, or use ':80' for plain HTTP testing.
yourdomain.com {
    # Reverse proxy public traffic to the internal Gunicorn socket.
    # Caddy automatically forwards X-Forwarded-For / X-Real-IP so Flask-Limiter
    # sees real client IPs.
    reverse_proxy 127.0.0.1:5000

    # Request logging with rotation.
    log {
        output file /var/log/caddy/affiliate_access.log {
            roll_size 10mb
            roll_keep 5
        }
    }

    # Security headers.
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Compression.
    encode gzip zstd
}
