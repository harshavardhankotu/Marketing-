[Unit]
Description=Autonomous B2B Lead Generation, Cold Outreach & Meeting Booking Engine
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/outbound
EnvironmentFile=/var/www/outbound/.env
ExecStart=/var/www/outbound/venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 127.0.0.1:5000 \
    --timeout 60 \
    --access-logfile /var/log/outbound/access.log \
    --error-logfile /var/log/outbound/error.log \
    app:app

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
